
## Chaptarr stores its data in an SQLite database inside /config by default.
## No database setup is required.
##
## To use PostgreSQL instead, set Chaptarr__Postgres__Host to a non-blank value
## and fill in the connection settings.
##
## PostgreSQL is supported for fresh installs only. There is no migration
## path from an existing SQLite database. The postgres databases need to
## be manually created.

# Database settings
Chaptarr__Postgres__Host=''
Chaptarr__Postgres__Port='5432'
Chaptarr__Postgres__User='chaptarr<__instance>'
Chaptarr__Postgres__Password='changeme'
Chaptarr__Postgres__MainDb='chaptarr<__instance>-main'
Chaptarr__Postgres__LogDb='chaptarr<__instance>-log'
Chaptarr__Postgres__CacheDb='chaptarr<__instance>-cache'
