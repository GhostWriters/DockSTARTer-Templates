## Wallos reads its settings from the database and configures everything in the
## Admin UI. The variables below are optional overrides: setting one takes full
## precedence over the value stored in the database, and the matching field in
## the UI is shown but disabled. Leave them commented out to manage Wallos from
## the UI only -- an empty value still counts as set and would override the
## database.

## OIDC / OAuth login. With OIDC_ISSUER set, Wallos discovers the authorization,
## token and user info endpoints from /.well-known/openid-configuration.
#OIDC_ENABLED='true'
#OIDC_PROVIDER_NAME='My IdP'
#OIDC_CLIENT_ID=''
#OIDC_CLIENT_SECRET=''
#OIDC_ISSUER='https://idp.example.com'
## Wallos handles the callback on any page, so point this at the site root.
#OIDC_REDIRECT_URL='https://wallos.example.com/'
#OIDC_DISABLE_PASSWORD_LOGIN='false'

## Hosts Wallos is allowed to reach on private/loopback addresses for webhooks,
## SMTP and OIDC. Comma separated, port optional.
#SSRF_ALLOWLIST='idp.example.com,192.168.1.100:8123'
