## Database (requires the MariaDB app, see README)
DB_HOST='mariadb'
DB_PORT='3306'
DB_NAME='romm'
DB_USER='romm-user'
DB_PASSWD=''
## Generate with: openssl rand -hex 32
ROMM_AUTH_SECRET_KEY=''
## Metadata providers (optional, but at least one is recommended)
## https://docs.romm.app/latest/Getting-Started/Metadata-Providers/
IGDB_CLIENT_ID=''
IGDB_CLIENT_SECRET=''
SCREENSCRAPER_USER=''
SCREENSCRAPER_PASSWORD=''
RETROACHIEVEMENTS_API_KEY=''
STEAMGRIDDB_API_KEY=''
HASHEOUS_API_ENABLED='true'
## Performance
SCAN_WORKERS='4'
WEB_SERVER_CONCURRENCY='4'
