ROMM<__INSTANCE>__ENABLED='false'
ROMM<__INSTANCE>__CONTAINER_NAME='romm<__instance>'
ROMM<__INSTANCE>__HOSTNAME='RomM<__Instance>'
ROMM<__INSTANCE>__NETWORK_MODE=''
ROMM<__INSTANCE>__PORT_8080='8080'
ROMM<__INSTANCE>__RESTART='unless-stopped'
ROMM<__INSTANCE>__STORAGE_ON=''     # Blank uses DOCKER_STORAGE_ON value. Set to YES/NO to override
ROMM<__INSTANCE>__STORAGE2_ON=''    # Blank uses DOCKER_STORAGE2_ON value. Set to YES/NO to override
ROMM<__INSTANCE>__STORAGE3_ON=''    # Blank uses DOCKER_STORAGE3_ON value. Set to YES/NO to override
ROMM<__INSTANCE>__STORAGE4_ON=''    # Blank uses DOCKER_STORAGE4_ON value. Set to YES/NO to override
ROMM<__INSTANCE>__TAG='latest'
ROMM<__INSTANCE>__VOLUME_LIBRARY="${DOCKER_VOLUME_STORAGE?}/romm<__instance>/library"
