
## Runtime & Permissions
## https://github.com/alexta69/metube#-runtime--permissions
#PUID="${PUID?}"
#PGID="${PGID?}"
#UMASK="${UMASK?}"
DEFAULT_THEME='auto'
LOGLEVEL='info'
ENABLE_ACCESSLOG='false'

## Download Behavior
## https://github.com/alexta69/metube#%EF%B8%8F-download-behavior
MAX_CONCURRENT_DOWNLOADS='3'
DELETE_FILE_ON_TRASHCAN='false'
DEFAULT_OPTION_PLAYLIST_ITEM_LIMIT='0'
SUBSCRIPTION_DEFAULT_CHECK_INTERVAL='60'
SUBSCRIPTION_SCAN_PLAYLIST_END='50'
SUBSCRIPTION_MAX_SEEN_IDS='50000'
CLEAR_COMPLETED_AFTER='0'

## Storage & Directories
## https://github.com/alexta69/metube#-storage--directories
DOWNLOAD_DIR='/storage/metube<__instance>'
AUDIO_DOWNLOAD_DIR="${DOWNLOAD_DIR?}"
CUSTOM_DIRS='true'
CREATE_CUSTOM_DIRS='true'
CUSTOM_DIRS_EXCLUDE_REGEX='(^|/)[.@].*$'
DEFAULT_FOLDER=''
DOWNLOAD_DIRS_INDEXABLE='false'
STATE_DIR="${DOWNLOAD_DIR?}/.metube"
TEMP_DIR="${DOWNLOAD_DIR?}"
CHOWN_DIRS='true'

## File Naming & yt-dlp
## https://github.com/alexta69/metube#-file-naming--yt-dlp
OUTPUT_TEMPLATE='%(title)s.%(ext)s'
OUTPUT_TEMPLATE_CHAPTER='%(title)s - %(section_number)s %(section_title)s.%(ext)s'
OUTPUT_TEMPLATE_PLAYLIST='%(playlist_title)s/%(title)s.%(ext)s'
OUTPUT_TEMPLATE_CHANNEL='%(channel)s/%(title)s.%(ext)s'
YTDL_OPTIONS='{}'
YTDL_OPTIONS_FILE=''
YTDL_OPTIONS_PRESETS='{}'
YTDL_OPTIONS_PRESETS_FILE=''
ALLOW_YTDL_OPTIONS_OVERRIDES='false'
ALLOW_PRIVATE_ADDRESSES='false'
YTDL_NIGHTLY_UPDATE_TIME=''

## Web Server & URLs
## https://github.com/alexta69/metube#-web-server--urls
HOST='0.0.0.0'
PORT='8081'
URL_PREFIX='/'
PUBLIC_HOST_URL=''
PUBLIC_HOST_AUDIO_URL=''
HTTPS='false'
CERTFILE=''
KEYFILE=''
CORS_ALLOWED_ORIGINS=''
ROBOTS_TXT=''

## Configuring yt-dlp options
## https://github.com/alexta69/metube#%EF%B8%8F-configuring-yt-dlp-options
# See the README section above for the layering model (global options,
# presets, per-download overrides) and JSON examples for YTDL_OPTIONS,
# YTDL_OPTIONS_FILE, YTDL_OPTIONS_PRESETS, and YTDL_OPTIONS_PRESETS_FILE.
