PINCHFLAT<__INSTANCE>__ENABLED='false'
PINCHFLAT<__INSTANCE>__CONTAINER_NAME='pinchflat<__instance>'
PINCHFLAT<__INSTANCE>__HOSTNAME='Pinchflat<__Instance>'
PINCHFLAT<__INSTANCE>__NETWORK_MODE=''
PINCHFLAT<__INSTANCE>__PORT_8945='8945'
PINCHFLAT<__INSTANCE>__RESTART='unless-stopped'
PINCHFLAT<__INSTANCE>__STORAGE_ON=''     # Blank uses DOCKER_STORAGE_ON value. Set to YES/NO to override
PINCHFLAT<__INSTANCE>__STORAGE2_ON=''    # Blank uses DOCKER_STORAGE2_ON value. Set to YES/NO to override
PINCHFLAT<__INSTANCE>__STORAGE3_ON=''    # Blank uses DOCKER_STORAGE3_ON value. Set to YES/NO to override
PINCHFLAT<__INSTANCE>__STORAGE4_ON=''    # Blank uses DOCKER_STORAGE4_ON value. Set to YES/NO to override
PINCHFLAT<__INSTANCE>__TAG='latest'
PINCHFLAT<__INSTANCE>__VOLUME_DOWNLOADS="${DOCKER_VOLUME_STORAGE?}/downloads/pinchflat<__instance>"
