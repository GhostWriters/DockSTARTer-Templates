
# If this is an empty string, the API key will be generated on first run and displayed in the nzbfast log
NZBFAST_APIKEY=''
# Set this to '1' to allow connections without an API key.  Not recommended.
NZBFAST_OPEN='0'
# Where to place downlaoded files. It is suggested to set this to a path under /storage/
NZBFAST_OUT='/downloads'
