<APPNAME><__INSTANCE>__ENABLED='false'
<APPNAME><__INSTANCE>__CONTAINER_NAME='<appname><__instance>'
<APPNAME><__INSTANCE>__DEVICES='false'
<APPNAME><__INSTANCE>__DEVICE_DEV1='/dev/dri'
<APPNAME><__INSTANCE>__DEVICE_DEV2="${<APPNAME><__INSTANCE>__DEVICE_DEV1}"
<APPNAME><__INSTANCE>__DEVICE_DEV3="${<APPNAME><__INSTANCE>__DEVICE_DEV1}"
<APPNAME><__INSTANCE>__DEVICE_DEV4="${<APPNAME><__INSTANCE>__DEVICE_DEV1}"
<APPNAME><__INSTANCE>__HOSTNAME='<AppName><__Instance>'
<APPNAME><__INSTANCE>__NETWORK_MODE=''
<APPNAME><__INSTANCE>__PORT_8080='8080'
<APPNAME><__INSTANCE>__RESTART='unless-stopped'
<APPNAME><__INSTANCE>__STORAGE_ON=''     # Blank uses DOCKER_STORAGE_ON value. Set to YES/NO to override
<APPNAME><__INSTANCE>__STORAGE2_ON=''    # Blank uses DOCKER_STORAGE2_ON value. Set to YES/NO to override
<APPNAME><__INSTANCE>__STORAGE3_ON=''    # Blank uses DOCKER_STORAGE3_ON value. Set to YES/NO to override
<APPNAME><__INSTANCE>__STORAGE4_ON=''    # Blank uses DOCKER_STORAGE4_ON value. Set to YES/NO to override
<APPNAME><__INSTANCE>__TAG='latest'
