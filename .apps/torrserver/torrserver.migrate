###
### TORRSERVER<__INSTANCE> - .env
###
TORRSERVER<__INSTANCE>__CONTAINER_NAME  TORRSERVER<__INSTANCE>_CONTAINER_NAME
TORRSERVER<__INSTANCE>__ENABLED         TORRSERVER<__INSTANCE>_ENABLED
TORRSERVER<__INSTANCE>__HOSTNAME        TORRSERVER<__INSTANCE>_HOSTNAME
TORRSERVER<__INSTANCE>__NETWORK_MODE    TORRSERVER<__INSTANCE>_NETWORK_MODE
TORRSERVER<__INSTANCE>__PORT_8090       TORRSERVER<__INSTANCE>_PORT_8090
TORRSERVER<__INSTANCE>__RESTART         TORRSERVER<__INSTANCE>_RESTART
TORRSERVER<__INSTANCE>__STORAGE_ON      TORRSERVER<__INSTANCE>__STORAGE
TORRSERVER<__INSTANCE>__STORAGE2_ON     TORRSERVER<__INSTANCE>__STORAGE2
TORRSERVER<__INSTANCE>__STORAGE3_ON     TORRSERVER<__INSTANCE>__STORAGE3
TORRSERVER<__INSTANCE>__STORAGE4_ON     TORRSERVER<__INSTANCE>__STORAGE4
TORRSERVER<__INSTANCE>__TAG             TORRSERVER<__INSTANCE>_TAG
###
### TORRSERVER<__INSTANCE> - .env.app.torrserver<__instance>:
###
torrserver<__instance>:TS_DONTKILL      TORRSERVER<__INSTANCE>_TS_DONTKILL
torrserver<__instance>:TS_HTTPAUTH      TORRSERVER<__INSTANCE>_TS_HTTPAUTH
