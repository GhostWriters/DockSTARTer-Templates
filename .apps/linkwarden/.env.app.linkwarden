## Full list of variables: https://docs.linkwarden.app/self-hosting/environment-variables

## Public URL of this instance with /api/v1/auth appended. NextAuth builds its
## callback URLs from this, so it has to match how the browser reaches
## Linkwarden or every login redirect lands on the wrong host.
NEXTAUTH_URL='http://localhost:3000/api/v1/auth'
## Session signing key, required. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=''

## Connection to the companion containers, set automatically. The database
## credentials live in .env.app.linkwarden<__instance>-database and the search
## key in .env.app.linkwarden<__instance>-search, both shared with those
## containers. Changing the user or database name after the first start needs
## ${DOCKER_VOLUME_CONFIG}/linkwarden<__instance>-postgres wiped as well.
DATABASE_URL="postgresql://${DB_USERNAME?}:${DB_PASSWORD?}@${LINKWARDEN<__INSTANCE>___POSTGRES__CONTAINER_NAME?}:5432/${DB_DATABASE_NAME?}"
MEILI_HOST="http://${LINKWARDEN<__INSTANCE>___MEILISEARCH__CONTAINER_NAME?}:7700"

## Registration and login. Leave commented out to keep Linkwarden's defaults --
## an empty value still counts as set.
#NEXT_PUBLIC_DISABLE_REGISTRATION='true'
#NEXT_PUBLIC_CREDENTIALS_ENABLED='false'
#DISABLE_NEW_SSO_USERS='true'

## Generic OIDC single sign on. OIDC_WELLKNOWN_URL points at the provider's
## /.well-known/openid-configuration document. Linkwarden's redirect URI is
## <NEXTAUTH_URL>/callback/oidc
#NEXT_PUBLIC_OIDC_ENABLED='true'
#OIDC_CUSTOM_NAME='My IdP'
#OIDC_WELLKNOWN_URL='https://idp.example.com/.well-known/openid-configuration'
#OIDC_CLIENT_ID=''
#OIDC_CLIENT_SECRET=''
#OIDC_SCOPES='openid profile email'
