
## The following settings will be ignored if you mount a config file.
## However, the variables defined here can be referenced in the config file by using ${VARNAME} in it.
##
## You mount a config file by placing the following in your docker-compose.overrride.yml file:
##
##   doplarrrs:
##     volumes:
##       ${DOCKER_VOLUME_CONFIG?}/doplarrrs/config.toml:/config.toml:ro
##
## An example config file can be found at:
##   https://github.com/activexray/doplarr_rs/blob/main/config.example.toml
##

# Global settings
LOG_LEVEL='info'
PARTIAL_SEASONS='true'

# Discord settings
DISCORD__MAX_RESULTS='25'
DISCORD__REQUESTED_MSG_STYLE=':plain'
DISCORD__TOKEN=''

# Seerr settings
OVERSEERR__API=''
OVERSEERR__DEFAULT_ID=''
OVERSEERR__URL='http://seerr:5055'

# Radarr settings (disabled if using Seerr)
RADARR__API=''
RADARR__QUALITY_PROFILE=''
RADARR__ROOTFOLDER=''
RADARR__URL='http://radarr:7878'

# Sonarr settings (disabled if using Seerr)
SONARR__API=''
SONARR__LANGUAGE_PROFILE=''
SONARR__QUALITY_PROFILE=''
SONARR__ROOTFOLDER=''
SONARR__URL='http://sonarr:8989'
