
## Authentication
# AUTH_METHOD: "external" turns off the built-in sign-in; any other value uses it
AUTH_METHOD='internal'
# WEB_AUTH_TOKEN: a fixed token for the web UI; blank makes one on first start and saves it in /config/auth.json
WEB_AUTH_TOKEN=''

## Mode settings
# MODE: "node" runs a worker node; blank or any other value runs the app (other mode variables only apply if this is "node")
MODE=''
# NODE_NAME: the name the app shows for this node; blank uses the container's hostname
NODE_NAME=''
# NODE_KEY: the key the app connects with, 16 to 200 characters with no spaces; blank makes one and prints it once in the log
NODE_KEY=''
