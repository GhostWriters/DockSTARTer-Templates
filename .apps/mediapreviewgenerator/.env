MEDIAPREVIEWGENERATOR<__INSTANCE>__ENABLED='false'
MEDIAPREVIEWGENERATOR<__INSTANCE>__CONTAINER_NAME='mediapreviewgenerator<__instance>'
MEDIAPREVIEWGENERATOR<__INSTANCE>__DEVICES='false'
MEDIAPREVIEWGENERATOR<__INSTANCE>__DEVICE_DEV1='/dev/dri'
MEDIAPREVIEWGENERATOR<__INSTANCE>__DEVICE_DEV2="${MEDIAPREVIEWGENERATOR<__INSTANCE>__DEVICE_DEV1}"
MEDIAPREVIEWGENERATOR<__INSTANCE>__DEVICE_DEV3="${MEDIAPREVIEWGENERATOR<__INSTANCE>__DEVICE_DEV1}"
MEDIAPREVIEWGENERATOR<__INSTANCE>__DEVICE_DEV4="${MEDIAPREVIEWGENERATOR<__INSTANCE>__DEVICE_DEV1}"
MEDIAPREVIEWGENERATOR<__INSTANCE>__HOSTNAME='MediaPreviewGenerator<__Instance>'
MEDIAPREVIEWGENERATOR<__INSTANCE>__NETWORK_MODE=''
MEDIAPREVIEWGENERATOR<__INSTANCE>__PORT_8080='8080'
MEDIAPREVIEWGENERATOR<__INSTANCE>__RESTART='unless-stopped'
MEDIAPREVIEWGENERATOR<__INSTANCE>__STORAGE_ON=''     # Blank uses DOCKER_STORAGE_ON value. Set to YES/NO to override
MEDIAPREVIEWGENERATOR<__INSTANCE>__STORAGE2_ON=''    # Blank uses DOCKER_STORAGE2_ON value. Set to YES/NO to override
MEDIAPREVIEWGENERATOR<__INSTANCE>__STORAGE3_ON=''    # Blank uses DOCKER_STORAGE3_ON value. Set to YES/NO to override
MEDIAPREVIEWGENERATOR<__INSTANCE>__STORAGE4_ON=''    # Blank uses DOCKER_STORAGE4_ON value. Set to YES/NO to override
MEDIAPREVIEWGENERATOR<__INSTANCE>__TAG='latest'
MEDIAPREVIEWGENERATOR<__INSTANCE>__VOLUME_PLEX_DATA="${DOCKER_VOLUME_CONFIG?}/plex/Library/Application Support/Plex Media Server"
