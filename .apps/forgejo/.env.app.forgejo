## Forgejo storage (repos, LFS, attachments, packages, archives, actions
## logs and artifacts) is stored on the storage volume. Config, database,
## logs, avatars, queues and indexes stay in the appdata folder (/data).
## Set a value to '' to use the Forgejo default location under /data instead.

FORGEJO__attachment__PATH='/storage/forgejo<__instance>/attachments'
FORGEJO__repository__ROOT='/storage/forgejo<__instance>/repositories'
FORGEJO__storage__PATH='/storage/forgejo<__instance>'
